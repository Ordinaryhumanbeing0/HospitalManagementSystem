datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
  NET_BANKING
}

// ----------------------------------------------------
// Core Identity & Worklet 1 Models
// ----------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PATIENT)
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient       Patient?
  doctor        Doctor?
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  doctors     Doctor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Doctor {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  specialization  String
  qualification   String
  consultationFee Decimal          @db.Decimal(10, 2)
  schedules       DoctorSchedule[]
  appointments    Appointment[]
  medicalReports  MedicalReport[]
  prescriptions   Prescription[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([departmentId])
}

model Patient {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth           DateTime
  gender                String
  bloodGroup            String?
  address               String?
  emergencyContact      String?
  medicalHistorySummary String?
  appointments          Appointment[]
  medicalReports        MedicalReport[]
  prescriptions         Prescription[]
  bills                 Bill[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ----------------------------------------------------
// Worklet 2 & 3 Supporting Models
// ----------------------------------------------------

model DoctorSchedule {
  id           String   @id @default(cuid())
  doctorId     String
  doctor       Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String   // e.g. "09:00"
  endTime      String   // e.g. "17:00"
  slotDuration Int      @default(30) // in minutes
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([doctorId])
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          Doctor            @relation(fields: [doctorId], references: [id])
  appointmentDate DateTime          @db.Date
  timeSlot        String            // e.g. "10:30"
  status          AppointmentStatus @default(CONFIRMED)
  reason          String?
  prescription    Prescription?
  bill            Bill?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([doctorId, appointmentDate, timeSlot])
  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentDate])
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id])
  diagnosis     String
  notes         String?
  medications   Json        // Array of { name, dosage, frequency, duration }
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model MedicalReport {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id])
  doctorId   String?
  doctor     Doctor?  @relation(fields: [doctorId], references: [id])
  title      String
  reportType String   // e.g. Blood Test, MRI, X-Ray, etc.
  fileUrl    String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
}

model Bill {
  id            String        @id @default(cuid())
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id])
  totalAmount   Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0.00) @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0.00) @db.Decimal(10, 2)
  status        PaymentStatus @default(UNPAID)
  items         Json          // Itemized breakdown: [{ title, cost, quantity }]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([patientId])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  billId         String
  bill           Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  transactionRef String?
  receivedAt     DateTime      @default(now())

  @@index([billId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
